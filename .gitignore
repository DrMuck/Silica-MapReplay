# Raw game assets (packed into assets.pak)
Assets/

# User-specific Python path config (auto-generated on first run)
python_config.bat

# Generated replays
Replays/

# Log emulator sandbox (emulated logs, streamed .srpl copies, session marker)
Emulator/

# Single-instance run lock
mapreplay_service.lock
mapreplay_service.pid

# Log files
*.log

# Python cache
__pycache__/
*.pyc

# Editor files
.vscode/
*.swp
